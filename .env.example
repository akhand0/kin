# ─────────────────────────────────────────────────────────────
# Kin environment
#
# Everything below is OPTIONAL. With no keys set, the app runs in
# DEMO MODE: an in-memory seeded store + heuristic triage, so the
# full loop works offline. Add keys to switch to the real backends.
# ─────────────────────────────────────────────────────────────

# --- Triage intelligence --------------------------------------
# Provider order: OpenAI (if key set) → Claude (if key set) → keyword
# heuristic. Pin one with TRIAGE_PROVIDER = openai | anthropic.
# TRIAGE_PROVIDER=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# Anthropic (Claude)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# --- Supabase — data, realtime, and patient SSO ---------------
# Without these, the app uses an in-memory seeded store and the login page
# falls back to username+password against the demo accounts.
# Enable Google/Apple providers in Supabase Auth to activate SSO, and set the
# redirect URL to <your-origin>/auth/callback.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- ElevenLabs — patient voice widget ------------------------
# Public agent id for the embedded Conversational AI widget.
# Without it, the /talk page shows a text-based check-in fallback.
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=

# --- Security -------------------------------------------------
# Shared secret the anomaly-check cron and ElevenLabs webhook must send.
# Header: Authorization: Bearer <this value>
KIN_CRON_SECRET=dev-secret

# Signs the session cookie. Set a long random value in production.
KIN_SESSION_SECRET=dev-session-secret
